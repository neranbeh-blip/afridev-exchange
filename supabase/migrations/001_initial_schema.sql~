-- NOTIFICATIONS
-- ============================================================

create policy "Users view their notifications"
on public.notifications
for select
to authenticated
using (auth.uid() = user_id);

create policy "Users update their notifications"
on public.notifications
for update
to authenticated
using (auth.uid() = user_id)
with check (auth.uid() = user_id);

